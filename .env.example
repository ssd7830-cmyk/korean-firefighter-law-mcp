# 공공데이터포털 인증키 (소방청 API용)
# 발급: https://www.data.go.kr 회원가입 → 아래 5개 API 활용신청
#   - 소방청_화재정보서비스        https://www.data.go.kr/data/15077644/openapi.do
#   - 소방청_구급통계서비스        https://www.data.go.kr/data/15099428/openapi.do
#   - 소방청_특정소방대상물정보    https://www.data.go.kr/data/15155780/openapi.do
#   - 소방청_특정소방대상물소방시설정보 https://www.data.go.kr/data/15155779/openapi.do
#   - 소방청_국가위험물정보          https://www.data.go.kr/data/15061055/openapi.do
DATA_GO_KR_KEY=your-service-key-here

# 법제처 오픈API 인증키 (소방 법령·판례용)
# 발급: https://open.law.go.kr → OPEN API 신청
LAW_OC=your-law-oc-here

# 법제처 API 프로토콜 (폐쇄망/인증서 문제 시 http)
# LAW_API_PROTOCOL=https

# HTTP 공개 배포 시 필수 권장. /mcp와 /api/chat을 Bearer 토큰으로 보호
# SERVER_AUTH_TOKEN=change-to-a-long-random-value
# 챗봇에 별도 토큰을 쓰려면 지정 (미지정 시 SERVER_AUTH_TOKEN 공유)
# CHAT_AUTH_TOKEN=change-to-another-long-random-value
# CHAT_RATE_LIMIT_PER_MINUTE=60
# 신뢰할 수 있는 단일 리버스프록시 뒤에서만 true (X-Forwarded-For 사용)
# TRUST_PROXY=false

# 선택: AI 요약. 셋 중 하나만 사용
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_PROVIDER=gemini
# LLM_MODEL=
# LLM_TIMEOUT_MS=30000
